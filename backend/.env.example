# Banco de Dados
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk_db

# JWT
JWT_SECRET=sua_chave_jwt_super_secreta_aqui
JWT_EXPIRATION=7d

# Servidor
PORT=3001
NODE_ENV=development

# Email (SMTP)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=seu_email@seudominio.com
SMTP_PASS=sua_senha_smtp

# API Keys (se usar serviços externos)
OPENAI_API_KEY=sua_chave_openai
STRIPE_API_KEY=sua_chave_stripe

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Uploadify
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logs
LOG_LEVEL=debug

# Redis (Socket.IO adapter — conexão TCP, diferente da REST usada em outros pontos)
# Pegue essa URL no painel do Upstash: Database > Connect > "ioredis" (formato rediss://default:<password>@<host>:<port>)
# Opcional: sem ela, o Socket.IO funciona normalmente em uma única instância.
REDIS_URL=rediss://default:sua_senha@seu-endpoint.upstash.io:6379

# IA (classificação automática de chamados + sugestão de resposta para agentes)
# Opcional: sem essa chave, as duas features de IA ficam desativadas e o resto do app funciona normalmente.
ANTHROPIC_API_KEY=sk-ant-sua_chave_aqui
