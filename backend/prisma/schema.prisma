generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String?
  role             String    @default("CLIENT")
  provider         String    @default("email")
  tickets          Ticket[]  @relation("TicketOwner")
  assignedTickets  Ticket[]  @relation("TicketAssignee")
  comments         Comment[]
  ticketHistory    TicketHistory[] @relation("HistoryActor")
  notifications    Notification[]  @relation("NotificationRecipient")
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  active           Boolean   @default(true)
  // Disponível para receber tickets na distribuição automática (agente ausente = false)
  available        Boolean   @default(true)
}

model Ticket {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  fileUrl     String?
  userId      Int
  user        User      @relation("TicketOwner", fields: [userId], references: [id])
  assigneeId  Int?
  assignee    User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  history     TicketHistory[]
  notifications Notification[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId])
}

// Registro de tudo que acontece num ticket (quem fez, o quê e quando)
model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   Int?
  actor     User?    @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  // CREATED | AUTO_ASSIGNED | ASSIGNED | REASSIGNED | UNASSIGNED | TAKEN | STATUS_CHANGED | PRIORITY_CHANGED | EDITED
  action    String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  // Nota interna: só a equipe (qualquer papel diferente de CLIENT) enxerga
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         Int      @id @default(autoincrement())
  body       String
  senderId   Int
  receiverId Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, read])
}

model Permission {
  id                   Int      @id @default(autoincrement())
  role                 String   @unique
  canViewAllTickets    Boolean  @default(true)
  canCreateTicket      Boolean  @default(true)
  canEditTicket        Boolean  @default(false)
  canDeleteTicket      Boolean  @default(false)
  canChangeStatus      Boolean  @default(false)
  canChangePriority    Boolean  @default(false)
  canCommentAny        Boolean  @default(false)
  canViewReports       Boolean  @default(false)
  canManageUsers       Boolean  @default(false)
  canViewUsers         Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Notificações de cada pessoa (guardadas no servidor, valem em qualquer aparelho)
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // ASSIGNED | UNASSIGNED | TAKEN | STATUS_CHANGED | COMMENT
  type      String
  title     String
  body      String?
  ticketId  Int?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Configuração da distribuição automática de tickets (sempre uma única linha, id = 1)
model AssignmentSettings {
  id             Int      @id @default(1)
  // SUPERADMIN | ROUND_ROBIN | LEAST_LOADED
  mode           String   @default("SUPERADMIN")
  // Último agente que recebeu ticket (ponto de partida do rodízio)
  lastAssignedId Int?
  updatedAt      DateTime @updatedAt
}